PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cprt_sucata

# Segredo do JWT (gerado automaticamente; troque em produção)
JWT_SECRET=troque-por-um-texto-aleatorio-com-32-ou-mais-caracteres
JWT_EXPIRES_IN=12h
COOKIE_SECURE=false

# Administrador criado pelo seed (npm run db:seed)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Administrador

# Leitura automática das fotos (opcional)
ANTHROPIC_API_KEY=
# Modelo rápido (maioria das fotos) e modelo preciso (visor da balança e reenvio quando falha)
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_MODEL_PRECISE=claude-sonnet-5-5

MAX_UPLOAD_MB=15
